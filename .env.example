# PostgreSQL — validada al arrancar en src/lib/env.ts
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/balancert?schema=public"

NODE_ENV="development"

# Clave para cifrar el código del celular (32 bytes en base64). Generala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CODIGOS=""
