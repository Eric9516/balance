// ─── Evolución del Patrimonio Neto ────────────────────────────────────────────
// Una fila por tipo de movimiento (TipoMovimientoPN) por ejercicio.
// Columnas = los 6 componentes del PN según el PDF + totalAnterior (comparativo).
// Filas derivadas (saldo inicio modificado, saldo cierre) se calculan en la app.
// El resultado del ejercicio se copia automáticamente desde el EERR.

model EvolucionPNMovimiento {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId String @map("ejercicio_id") @db.Uuid
  tipo        TipoMovimientoPN
  orden       Int

  // Componentes del PN
  capitalSuscripto    Decimal @default(0) @db.Decimal @map("capital_suscripto")
  ajusteCapital       Decimal @default(0) @db.Decimal @map("ajuste_capital")
  aportesIrrevocables Decimal @default(0) @db.Decimal @map("aportes_irrevocables")
  reservaLegal        Decimal @default(0) @db.Decimal @map("reserva_legal")
  otrasReservas       Decimal @default(0) @db.Decimal @map("otras_reservas")
  rdosNoAsignados     Decimal @default(0) @db.Decimal @map("rdos_no_asignados")
  // total = suma de columnas (calculado en app)

  // Columna "Ejercicio Anterior" del comparativo
  totalAnterior Decimal @default(0) @db.Decimal @map("total_anterior")

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@unique([ejercicioId, tipo])
  @@map("evolucion_pn_movimientos")
}

// ─── Flujo de Efectivo ────────────────────────────────────────────────────────
// Método directo. Un registro de cabecera por ejercicio con N ítems por sección.
// El comparativo se guarda en importeAnterior de cada ítem porque las líneas
// pueden variar año a año (ítems distintos, conceptos nuevos/eliminados).

model FlujoDeCajaEjercicio {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId  String   @unique @map("ejercicio_id") @db.Uuid
  // Saldos de efectivo — bloque superior del estado (PDF página 6)
  // efectivo inicio + modificaciones = efectivo modificado inicio
  // efectivo cierre - efectivo modificado inicio = variación neta (calculada en app)
  saldoInicial              Decimal @default(0) @db.Decimal @map("saldo_inicial")
  modificacionesEjAnt       Decimal @default(0) @db.Decimal @map("modificaciones_ej_ant") // usualmente 0
  saldoFinal                Decimal @default(0) @db.Decimal @map("saldo_final")
  // Comparativo
  saldoInicialAnterior      Decimal @default(0) @db.Decimal @map("saldo_inicial_anterior")
  modificacionesEjAntAnt    Decimal @default(0) @db.Decimal @map("modificaciones_ej_ant_ant")
  saldoFinalAnterior        Decimal @default(0) @db.Decimal @map("saldo_final_anterior")
  createdAt    DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  items     FlujoDeCajaItem[]

  @@map("flujo_caja_ejercicio")
}

model FlujoDeCajaItem {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  flujoId         String @map("flujo_id") @db.Uuid
  seccion         SeccionFlujo
  concepto        String
  // Positivo = ingreso de efectivo, negativo = egreso
  importe         Decimal      @default(0) @db.Decimal
  importeAnterior Decimal      @default(0) @db.Decimal @map("importe_anterior")
  esSubtotal      Boolean      @default(false) @map("es_subtotal")
  orden           Int
  createdAt       DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3) @map("updated_at")

  flujo FlujoDeCajaEjercicio @relation(fields: [flujoId], references: [id], onDelete: Cascade)

  @@index([flujoId])
  @@map("flujo_caja_items")
}

// ─── Bienes de Uso ────────────────────────────────────────────────────────────
// Una fila por categoría (Inmuebles, Rodados, Maquinaria, etc.).
// El comparativo se deriva del mismo modelo del ejercicio anterior
// (valor residual anterior = costoFin - depAcumFin del ejercicio previo).

model BienDeUsoCategoria {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId String @map("ejercicio_id") @db.Uuid
  categoria   String   // Ej: "Inmuebles", "Rodados", "Muebles y Útiles"
  orden       Int

  // ── Costo reexpresado ──────────────────────────────────────────────────────
  // Estructura exacta del Anexo I del PDF:
  // inicio + ajusteInflación + altas - bajas = cierre
  costoInicioReexpresado Decimal @default(0) @db.Decimal @map("costo_inicio_reexpresado")
  costoAjusteInflacion   Decimal @default(0) @db.Decimal @map("costo_ajuste_inflacion") // REI sobre costo
  altas                  Decimal @default(0) @db.Decimal
  bajas                  Decimal @default(0) @db.Decimal // al costo
  costoFinReexpresado    Decimal @default(0) @db.Decimal @map("costo_fin_reexpresado")

  // ── Depreciaciones acumuladas ──────────────────────────────────────────────
  // inicio + ajusteInflación + delEjercicio - deBajas = cierre
  depAcumInicio       Decimal @default(0) @db.Decimal @map("dep_acum_inicio")
  depAjusteInflacion  Decimal @default(0) @db.Decimal @map("dep_ajuste_inflacion") // REI sobre depreciaciones
  depEjercicio        Decimal @default(0) @db.Decimal @map("dep_ejercicio") // cargo del período
  depBajas            Decimal @default(0) @db.Decimal @map("dep_bajas") // dep. de bienes dados de baja
  depAcumFin          Decimal @default(0) @db.Decimal @map("dep_acum_fin")

  // Valor residual = costoFinReexpresado - depAcumFin (calculado en app)
  // netoResidualAnteriorManual: se usa cuando no hay ejercicio anterior vinculado al sistema.
  // Si hay ejercicio anterior, el comparativo se deriva automáticamente de ese registro.
  netoResidualAnteriorManual Decimal? @db.Decimal @map("neto_residual_anterior_manual")

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@unique([ejercicioId, categoria])
  @@map("bienes_de_uso_categorias")
}

// ─── Costo de Ventas ──────────────────────────────────────────────────────────
// Estructura fija: existencia inicial + compras + gastos fabricación - existencia final.
// El comparativo se deriva del ejercicio anterior (mismo modelo, ejercicioAnteriorId).

model CostoVentasEjercicio {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId String   @unique @map("ejercicio_id") @db.Uuid

  existenciaInicial  Decimal @default(0) @db.Decimal @map("existencia_inicial")
  compras            Decimal @default(0) @db.Decimal
  gastosFabricacion  Decimal @default(0) @db.Decimal @map("gastos_fabricacion") // solo empresas industriales
  existenciaFinal    Decimal @default(0) @db.Decimal @map("existencia_final")
  // Total costo = existenciaInicial + compras + gastosFabricacion - existenciaFinal

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@map("costo_ventas_ejercicio")
}

