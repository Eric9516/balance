  @@unique([ejercicioId, modulo, clave])
  @@map("comparativo_manual")
}

// ─── Documentos sugeridos (anexos / notas dinámicos) ──────────────────────────
// Estado por ejercicio de cada anexo/nota. El catálogo de REGLAS vive en código
// (modules/documentos/domain/reglas.ts). Acá solo se persiste la DECISIÓN del
// contador. Un documento "sugerido" no genera fila: solo existe fila cuando hay
// una decisión explícita (aceptar / descartar / no aplica / manual).

enum TipoDocumento {
  ANEXO
  NOTA
}

enum EstadoDocumento {
  SUGERIDO
  ACEPTADO
  DESCARTADO
  NO_APLICA
}

enum OrigenDocumento {
  AUTOMATICO
  MANUAL
}

model DocumentoEjercicio {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId    String @map("ejercicio_id") @db.Uuid
  reglaClave     String? @map("regla_clave") // null = documento agregado manualmente
  tipo           TipoDocumento
  titulo         String
  estado         EstadoDocumento @default(SUGERIDO)
  origen         OrigenDocumento @default(AUTOMATICO)
  saldoAlAceptar Decimal?        @db.Decimal @map("saldo_al_aceptar") // foto del saldo al aceptar — para detectar saldo 0 posterior
  createdAt      DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@unique([ejercicioId, reglaClave])
  @@map("documentos_ejercicio")
}

// ─── Nota de Primera Aplicación RT 54 ─────────────────────────────────────────
// Partidas de la conciliación entre el PN / resultado anterior según normas
// previas y según RT 54. Solo tiene sentido cuando adopcionRT54 = PRIMERA_ADOPCION.
// La fila "Modificación de saldos al inicio" del E.E.P.N. se VALIDA contra la suma
// de los AJUSTE_MEDICION (no se deriva: esa fila también recibe correcciones de
// errores y cambios de políticas que no son transición).

model AjusteTransicionRT54 {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId String @map("ejercicio_id") @db.Uuid
  orden       Int
  tipo        TipoAjusteTransicion
  concepto    String
  descripcion String?
  // AJUSTE_MEDICION: componente del PN afectado + efecto sobre el PN al inicio
  // y sobre el resultado del ejercicio anterior.
  componentePN             ComponentePN? @map("componente_pn")
  importePN                Decimal @default(0) @db.Decimal @map("importe_pn")
  importeResultadoAnterior Decimal @default(0) @db.Decimal @map("importe_resultado_anterior")
  // RECLASIFICACION: rubro de origen y destino del importe reclasificado (sin efecto en PN).
  rubroOrigen  String? @map("rubro_origen")
  rubroDestino String? @map("rubro_destino")
  importeReclasificado Decimal @default(0) @db.Decimal @map("importe_reclasificado")
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@index([ejercicioId])
  @@map("ajustes_transicion_rt54")
}

// Config por sección legacy de gastos (las que no tienen RubroGrupo)
// Permite controlar aparecEnEERR y orden igual que los grupos custom.
model GastoSeccionConfig {
  // Cada estudio tiene la suya (migración 20261030120000_catalogo_por_estudio)
  estudioId    String  @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  clave        String  // ej: "legacy:GASTOS_ADM"
  aparecEnEERR Boolean @default(true) @map("aparec_en_eerr")
  orden        Int     @default(9999)

  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@id([estudioId, clave])
  @@map("gasto_seccion_config")
}
