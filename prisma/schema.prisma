generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum EstadoDestino {
  SSP
  EERR
  PN
}

enum SeccionSSP {
  ACTIVO_CORRIENTE
  ACTIVO_NO_CORRIENTE
  PASIVO_CORRIENTE
  PASIVO_NO_CORRIENTE
  PATRIMONIO_NETO
}

enum SeccionEERR {
  INGRESOS
  COSTO_VENTAS
  GASTOS_ADM
  GASTOS_COM
  GASTOS_BANCARIOS
  IMPUESTOS_CONTRIBUCIONES
  RESULTADOS_FINANCIEROS
  IMPUESTO_GANANCIAS
}

enum NaturalezaEsperada {
  DEUDORA
  ACREEDORA
}

enum TipoPersona {
  FISICA
  JURIDICA
}

enum EstadoEjercicio {
  BORRADOR
  EN_PROCESO
  REVISION
  CERRADO
}

enum AdopcionRT54 {
  PRIMERA_ADOPCION
  APLICACION_CONTINUADA
}

// Cómo se resuelve el ejercicio anterior (saldos de inicio + columna comparativa).
// null en EjercicioContable.modoAnterior = todavía no configurado (bloquea la autorización final).
enum ModoEjercicioAnterior {
  VINCULADO    // el anterior está cargado en el sistema: saldos de inicio y comparativos derivados y bloqueados
  MANUAL       // sin historial en el sistema: comparativos y saldos de inicio cargados a mano y autorizados
  SIN_ANTERIOR // primer ejercicio de la sociedad: no hay columna comparativa
}

// Categoría del ente según RT 54 (flexibiliza notas y mediciones).
enum CategoriaEnteRT54 {
  PEQUENA
  MEDIANA
  RESTANTE
}

// Nota de Primera Aplicación RT 54: tipo de partida de la conciliación.
enum TipoAjusteTransicion {
  AJUSTE_MEDICION   // modifica el PN al inicio y/o el resultado del ejercicio anterior
  RECLASIFICACION   // solo exposición: mueve importe entre rubros, sin efecto en PN
}

// Componente del PN afectado por un ajuste de transición (mismas columnas del E.E.P.N.).
enum ComponentePN {
  CAPITAL_SUSCRIPTO
  AJUSTE_CAPITAL
  APORTES_IRREVOCABLES
  RESERVA_LEGAL
  OTRAS_RESERVAS
  RDOS_NO_ASIGNADOS
}

enum CriteriosBienesCambio {
  COSTO_ADQUISICION
  ULTIMA_COMPRA
  COSTO_REPOSICION
}

enum EstadoImportacion {
  PENDIENTE
  PROCESANDO
  COMPLETADA
  CON_ERRORES
  CANCELADA
}

enum ModoImportacion {
  REEMPLAZAR
  AGREGAR
  SIMULAR
}

enum EstadoValidacion {
  ACTIVA
  RESUELTA
  IGNORADA
}

enum SeveridadValidacion {
  ERROR
  ADVERTENCIA
  INFO
}

enum TipoValidacion {
  CUADRE_BALANCE
  SALDO_NEGATIVO
  CUENTA_SIN_CLASIFICAR
  CONSISTENCIA_EJERCICIO
  NOTA_INCOMPLETA
  PATRIMONIO_NETO
  REEXPRESION_FALTANTE    // ejercicio anterior no ajustado por inflación
  ANEXO_INCONSISTENTE     // totales de anexo no coinciden con estado
}

// Rol de una persona dentro de su estudio (decisión del dueño del producto, 2026-10-30)
enum RolUsuario {
  DUENO // todo, incluso la gente y la configuración del estudio
  CONTADOR // arma, confirma y cierra los balances
  ASISTENTE // carga datos y avisa que terminó; no confirma ni cierra
}

enum TipoNota {
  INFORMATIVA
  CUANTITATIVA
  POLITICA_CONTABLE
}

enum SeccionFlujo {
  ACTIVIDADES_OPERATIVAS
  ACTIVIDADES_INVERSION
  ACTIVIDADES_FINANCIAMIENTO
}

enum TipoMovimientoPN {
  SALDO_INICIO
  AJUSTE_INFLACION
  MODIFICACION_INICIO          // Nota 1.6 — primer ejercicio con RT 54
  DISTRIB_HONORARIOS
  DISTRIB_DIVIDENDOS
  DISTRIB_RESERVA_LEGAL
  DISTRIB_OTRAS_RESERVAS
  DISTRIB_APORTES_IRREVOCABLES
  RESULTADO_EJERCICIO
}

enum TipoErrorTecnico {
  DATABASE
  VALIDACION
  IMPORTACION
  CALCULO
  SISTEMA
}

enum SeveridadError {
  CRITICO
  ALTO
  MEDIO
  BAJO
}

// Densidad visual de las tablas de trabajo, preferencia por estudio.
enum DensidadTablas {
  COMODA
  COMPACTA
}

enum NivelComparativoSSP {
  SECCION
  RUBRO
}

enum ModuloSistema {
  RUBROS
  CUENTAS
  IMPORTACION
  CLASIFICACION
  VALIDACION
  NOTAS
  ESTADOS_CONTABLES
  PATRIMONIO_NETO
  PREVIEW
  EXPORTACION
  SOCIEDADES
  AUDITORES
  EJERCICIOS
  CONFIGURACION_ESTUDIO
}

// ─── Core ─────────────────────────────────────────────────────────────────────

// Secciones personalizables creadas por el usuario (agrupa RubroBases)
// esGasto=true → aparece en Anexo III como columna (auto-calculada)
// aparecEnEERR=true → además aparece como línea de gasto en el EERR
// aparecEnEERR=false → solo en Anexo III (ej: gastos vinculados al costo, ya incluidos en Costo de Ventas)
model RubroGrupo {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Cada estudio tiene su propio catálogo (migración 20261030120000_catalogo_por_estudio)
  estudioId     String         @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  nombre        String
  sigla         String?        // Ej: "GTO", "GAST" — definida por el contador
  esGasto       Boolean        @default(false) @map("es_gasto")
  aparecEnEERR  Boolean        @default(true) @map("aparec_en_eerr")
  estadoDestino EstadoDestino? @map("estado_destino")
  seccionSSP    SeccionSSP? @map("seccion_ssp")
  seccionEERR   SeccionEERR? @map("seccion_eerr")
  orden         Int
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio Estudio     @relation(fields: [estudioId], references: [id], onDelete: Cascade)
  rubros  RubroBase[]

  @@index([estudioId, orden])
  @@map("rubros_grupo")
}

model RubroBase {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Cada estudio tiene su propio catálogo: al crearse recibe una copia del oficial (CatalogoRubro)
  estudioId          String             @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  rubroGrupoId       String? @map("rubro_grupo_id") @db.Uuid
  codigo             String
  nombre             String
  descripcion        String?
  estadoDestino      EstadoDestino @map("estado_destino")
  seccionSSP         SeccionSSP? @map("seccion_ssp")
  seccionEERR        SeccionEERR? @map("seccion_eerr")
  naturalezaEsperada NaturalezaEsperada @map("naturaleza_esperada")
  orden              Int
  activo                Boolean            @default(true)
  generaNotaInformativa Boolean            @default(false) @map("genera_nota_informativa")
  // Efectivo y equivalentes: sus cuentas forman el efectivo al inicio y al cierre del
  // Estado de Flujo de Efectivo (se deriva del SSP, no se carga a mano).
  esEfectivo            Boolean            @default(false) @map("es_efectivo")
  textoNotaDefault      String? @map("texto_nota_default")
  createdAt             DateTime           @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio       Estudio             @relation(fields: [estudioId], references: [id], onDelete: Cascade)
  rubroGrupo    RubroGrupo?         @relation(fields: [rubroGrupoId], references: [id], onDelete: SetNull)
  cuentas       CuentaContable[]
  rubrosEstudio RubroActivoEstudio[]

  @@unique([estudioId, codigo])
  @@unique([estudioId, orden])
  @@index([rubroGrupoId])
  @@map("rubros_base")
}

// Catálogo oficial de la RT 54. Es de la plataforma, no de un estudio: cada estudio nuevo recibe
// una copia en RubroBase al crearse (disparador "catalogo" en estudios) y después cambia la suya.
// La app no lo lee; una incorporación oficial es una migración que lo agrega acá y en cada estudio.
model CatalogoRubro {
  id                    String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  codigo                String             @unique
  nombre                String
  descripcion           String?
  estadoDestino         EstadoDestino      @map("estado_destino")
  seccionSSP            SeccionSSP?        @map("seccion_ssp")
  seccionEERR           SeccionEERR?       @map("seccion_eerr")
  naturalezaEsperada    NaturalezaEsperada @map("naturaleza_esperada")
  orden                 Int                @unique
  activo                Boolean            @default(true)
  generaNotaInformativa Boolean            @default(false) @map("genera_nota_informativa")
  esEfectivo            Boolean            @default(false) @map("es_efectivo")
  textoNotaDefault      String?            @map("texto_nota_default")
  createdAt             DateTime           @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@map("catalogo_rubros")
}

model RubroActivoEstudio {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId String @map("estudio_id") @db.Uuid
  rubroId   String @map("rubro_id") @db.Uuid
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  estudio Estudio   @relation(fields: [estudioId], references: [id], onDelete: Cascade)
  rubro   RubroBase @relation(fields: [rubroId], references: [id], onDelete: Cascade)

  @@unique([estudioId, rubroId])
  @@index([rubroId])
  @@map("rubros_activos_estudio")
}

// ─── Estudio ──────────────────────────────────────────────────────────────────

model Estudio {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nombre      String
  cuit        String      @unique
  razonSocial String @map("razon_social")
  tipoPersona TipoPersona @default(JURIDICA) @map("tipo_persona")
  domicilio   String?
  localidad   String?
  provincia   String?
  telefono    String?
  email       String?
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3) @map("updated_at")

  configuracion   EstudioConfiguracion?
  sociedades      Sociedad[]
  auditores       Auditor[]
  usuarios        Usuario[]
  plantillasNotas PlantillaNota[]
  mapeosExcel     MapeoExcel[]
  rubrosActivos   RubroActivoEstudio[]
  rubrosGrupo     RubroGrupo[]
  rubrosBase      RubroBase[]
  gastoSecciones  GastoSeccionConfig[]

  @@map("estudios")
}

model EstudioConfiguracion {
  id                     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId              String   @unique @map("estudio_id") @db.Uuid
  logoUrl                String? @map("logo_url")
  // Acento de la interfaz (identidad del estudio). Hex #RRGGBB con contraste suficiente
  // sobre blanco (validado en dominio: estudios/domain/preferencias.ts).
  colorPrimario          String   @default("#2F6B55") @map("color_primario")
  // Densidad de las tablas de trabajo (EEPN, anexos, estados).
  densidadTablas         DensidadTablas @default(COMODA) @map("densidad_tablas")
  monedaDisplay          String   @default("ARS") @map("moneda_display")
  decimalesDisplay       Int      @default(0) @map("decimales_display")
  mostrarNotasEnPreview  Boolean  @default(true) @map("mostrar_notas_en_preview")
  firmaDigitalHabilitada Boolean  @default(false) @map("firma_digital_habilitada")
  createdAt              DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt              DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@map("estudio_configuracion")
}

// Quién entra a la app. Una cuenta por estudio: el correo es único en toda la plataforma y se
// guarda en minúsculas. La contraseña y las sesiones viven aparte, en el esquema acceso, cerrado
// para la app (migración 20261030180000_login_propio). Siempre queda un dueño activo por estudio.
model Usuario {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId     String     @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  email         String     @unique
  nombre        String
  rol           RolUsuario
  activo        Boolean    @default(true)
  ultimoIngreso DateTime?  @db.Timestamptz(3) @map("ultimo_ingreso")
  createdAt     DateTime   @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio Estudio @relation(fields: [estudioId], references: [id], onDelete: Cascade)

  @@index([estudioId])
  @@map("usuarios")
}

// ─── Sociedad / Auditor ───────────────────────────────────────────────────────

model Sociedad {
  id                  String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId           String @map("estudio_id") @db.Uuid
  razonSocial         String @map("razon_social")
  cuit                String      @unique
  tipoPersona         TipoPersona @default(JURIDICA) @map("tipo_persona")
  tipoSocietario      String? @map("tipo_societario")
  condicionFiscal     String? @map("condicion_fiscal")
  domicilioLegal      String? @map("domicilio_legal")
  localidad           String?
  provincia           String?
  codigoPostal        String? @map("codigo_postal")
  actividadPpal       String? @map("actividad_ppal")
  actividadSecundaria String? @map("actividad_secundaria")
  clasificacionRT54   String? @map("clasificacion_rt54")
  categoriaEnte       CategoriaEnteRT54? @map("categoria_ente") // valor por defecto para ejercicios nuevos de la sociedad
  fechaInscripcion    DateTime? @db.Date @map("fecha_inscripcion")
  matriculaPJ         String? @map("matricula_pj")
  plazoDuracion       DateTime? @db.Date @map("plazo_duracion")
  composicionCapital  String? @map("composicion_capital")
  activo              Boolean     @default(true)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio    Estudio             @relation(fields: [estudioId], references: [id], onDelete: Restrict)
  ejercicios EjercicioContable[]

  @@index([estudioId])
  @@map("sociedades")
}

model Auditor {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId          String @map("estudio_id") @db.Uuid
  nombre             String
  apellido           String
  cuit               String?
  tituloProfesional  String? @map("titulo_profesional")
  matricula          String?
  consejoProfesional String? @map("consejo_profesional")
  universidad        String?
  localidadInforme   String? @map("localidad_informe")
  textoFirma         String? @map("texto_firma")
  firmaImagenUrl     String? @map("firma_imagen_url") // URL de imagen de la firma digital para pie de página
  esDefault          Boolean  @default(false) @map("es_default")
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt          DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio    Estudio             @relation(fields: [estudioId], references: [id], onDelete: Cascade)
  ejercicios EjercicioContable[]

  @@index([estudioId])
  @@map("auditores")
}

// ─── Ejercicio ────────────────────────────────────────────────────────────────

model EjercicioContable {
  id                  String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId           String @map("estudio_id") @db.Uuid
  sociedadId          String @map("sociedad_id") @db.Uuid
  auditorId           String? @map("auditor_id") @db.Uuid
  ejercicioAnteriorId String?         @unique @map("ejercicio_anterior_id") @db.Uuid
  numeroEjercicio     Int? @map("numero_ejercicio")
  fechaInicio         DateTime @db.Date @map("fecha_inicio")
  fechaCierre         DateTime @db.Date @map("fecha_cierre")
  fechaInformeAuditor     DateTime? @db.Date @map("fecha_informe_auditor")
  clasificacionEntidad    String? @map("clasificacion_entidad")
  indiceInflacionAnterior Decimal?  @db.Decimal @map("indice_inflacion_anterior")
  indiceInflacionActual   Decimal?  @db.Decimal @map("indice_inflacion_actual")
  denominacion            String
  estado              EstadoEjercicio @default(BORRADOR)
  // ── Configuración Nota I ──────────────────────────────────────────────────────
  adopcionRT54              AdopcionRT54? @map("adopcion_rt54")
  criteriosBienesCambio     CriteriosBienesCambio? @map("criterios_bienes_cambio")
  hechosPosterioress        Boolean? @map("hechos_posterioress")
  // Texto de la nota de hechos posteriores. Con "No" (false), null = sin nota y un texto = nota que
  // aclara que no hubo (ver textoNotaHechos en src/modules/notas/domain/regeneracion.ts).
  hechosPosterioressTexto   String? @map("hechos_posterioress_texto")
  // Nota 1 (bases de preparación): texto escrito por el contador; null = el que genera la app.
  notaUnoTexto              String?   @map("nota_uno_texto")
  notaUnoEditadaEn          DateTime? @db.Timestamptz(3) @map("nota_uno_editada_en")
  pnConfirmado                Boolean              @default(false) @map("pn_confirmado")
  estadosConfirmado           Boolean              @default(false) @map("estados_confirmado")
  // ── Ejercicio anterior ───────────────────────────────────────────────────────
  // modoAnterior es la única fuente de verdad. Invariantes (dominio):
  //   VINCULADO    ⇔ ejercicioAnteriorId != null
  //   MANUAL / SIN_ANTERIOR ⇒ ejercicioAnteriorId == null
  //   null         = pendiente de configurar
  modoAnterior                ModoEjercicioAnterior? @map("modo_anterior")
  // Autorización explícita de los saldos del ejercicio anterior cargados a mano (modo MANUAL).
  // Cualquier escritura posterior sobre comparativos la vuelve a null.
  comparativoAutorizadoEn     DateTime? @db.Timestamptz(3) @map("comparativo_autorizado_en")
  comparativoAutorizadoPor    String? @map("comparativo_autorizado_por")
  // Cuándo se ajustó por inflación el anterior cargado a mano. Null = se muestra lo cargado.
  anteriorAjustadoEn          DateTime? @db.Timestamptz(3) @map("anterior_ajustado_en")
  // Categoría del ente según RT 54 para este ejercicio (puede diferir de la sociedad).
  categoriaEnte               CategoriaEnteRT54? @map("categoria_ente")
  // Legacy (reemplazados por modoAnterior; se eliminan en una migración posterior)
  balanceAnteriorDisponible   Boolean              @default(true) @map("balance_anterior_disponible")
  nivelComparativoSSP         NivelComparativoSSP? @map("nivel_comparativo_ssp")
  auditorSnapshot     Json? @map("auditor_snapshot")
  createdAt           DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3) @map("updated_at")

  sociedad           Sociedad                 @relation(fields: [sociedadId], references: [id], onDelete: Restrict)
  auditor            Auditor?                 @relation(fields: [auditorId], references: [id], onDelete: SetNull)
  ejercicioAnterior  EjercicioContable?       @relation("EjercicioComparativo", fields: [ejercicioAnteriorId], references: [id], onDelete: SetNull)
  ejercicioSiguiente EjercicioContable?       @relation("EjercicioComparativo")
  cuentas               CuentaContable[]
  importaciones         ImportacionExcel[]
  notas                 NotaEjercicio[]
  validaciones          ErrorValidacion[]
  evolucionPN           EvolucionPNMovimiento[]
  flujoDeCaja           FlujoDeCajaEjercicio?
  bienesDeUso           BienDeUsoCategoria[]
  costoVentas           CostoVentasEjercicio?
  comparativoManual     ComparativoManual[]
  documentos            DocumentoEjercicio[]
  ajustesTransicion     AjusteTransicionRT54[]

  @@index([sociedadId, fechaCierre])
  @@index([auditorId])
  @@map("ejercicios_contables")
}

// ─── Importación ──────────────────────────────────────────────────────────────

model MapeoExcel {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  estudioId        String @map("estudio_id") @db.Uuid
  nombre           String
  descripcion      String?
  columnasCodigo   String[] @map("columnas_codigo")
  columnasNombre   String[] @map("columnas_nombre")
  columnasDeudor   String[] @map("columnas_deudor")
  columnasAcreedor String[] @map("columnas_acreedor")
  filasOmitir      Int      @default(0) @map("filas_omitir")
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  estudio       Estudio            @relation(fields: [estudioId], references: [id], onDelete: Cascade)
  importaciones ImportacionExcel[]

  @@index([estudioId])
  @@map("mapeos_excel")
}

model ImportacionExcel {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId     String @map("ejercicio_id") @db.Uuid
  mapeoExcelId    String? @map("mapeo_excel_id") @db.Uuid
  nombreArchivo   String @map("nombre_archivo")
  hashArchivo     String @map("hash_archivo")
  estado          EstadoImportacion @default(PENDIENTE)
  modo            ModoImportacion   @default(REEMPLAZAR)
  mapeoSnapshot   Json? @map("mapeo_snapshot")
  totalFilas      Int? @map("total_filas")
  filasImportadas Int? @map("filas_importadas")
  filasError      Int? @map("filas_error")
  erroresDetalle  Json? @map("errores_detalle")
  createdAt       DateTime          @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3) @map("updated_at")

  ejercicio  EjercicioContable @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  mapeoExcel MapeoExcel?       @relation(fields: [mapeoExcelId], references: [id], onDelete: SetNull)
  cuentas    CuentaContable[]

  @@index([ejercicioId])
  @@index([mapeoExcelId])
  @@map("importaciones_excel")
}

// ─── Cuentas ──────────────────────────────────────────────────────────────────

model CuentaContable {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
