// ─── Comparativo manual ───────────────────────────────────────────────────────
// Almacena los valores comparativos del ejercicio anterior cuando no se dispone
// del balance importado. Un registro por módulo + clave (sección o rubroBaseId).

model ComparativoManual {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // De qué estudio es: lo completa la base desde su ejercicio (docs/decisiones/0011)
  estudioId String @default(dbgenerated("estudio_de_la_sesion()")) @map("estudio_id") @db.Uuid
  ejercicioId String @map("ejercicio_id") @db.Uuid
  modulo      String            // 'SSP' | 'EERR' | 'GASTOS' | 'BDU'
  clave       String            // seccion key, rubroBaseId, o nombre de categoría
  label       String            // nombre para mostrar (clave legible)
  valor       Decimal           @db.Decimal
  esHuerfano  Boolean           @default(false) @map("es_huerfano") // true = no existe en el ejercicio actual
  orden       Int               @default(0)

