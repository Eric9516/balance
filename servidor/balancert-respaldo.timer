# Todas las noches a las 4:30 (hora argentina = 07:30 UTC), cuando nadie trabaja. Si el servidor estaba
# apagado, corre al prender.
[Unit]
Description=Respaldo nocturno de BalanceRT en Supabase

[Timer]
OnCalendar=*-*-* 07:30:00 UTC
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
